{
  // Cloudflare account that owns every Worker and provisioned resource.
  // Find it: https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
  "accountId": "1a4ab9bfc9016c26a79d18840d614a03",

  // Worker names are permanent service identities. Keep them unique within the account.
  // Reference: docs/customization.md#workers-and-routing
  "workers": {
    "workshop": {
      "name": "op-titan",

      // Production: use a hostname in an active Cloudflare zone. Wrangler creates DNS and TLS.
      // Evaluation: replace this with "route": { "workersDev": true }.
      // https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
      "route": { "customDomain": "originalpictures.dev" }
    },
    "context": { "name": "op-titan-context" },

    // Scheduled Tasks gatekeeper (ambient, no OAuth). Lets agents register recurring and one-shot
    // workspace runs; managed from /gatekeepers/scheduler. Deployed unconditionally like context.
    "scheduler": { "name": "op-titan-scheduler" },
    "customGatekeeper": { "name": "op-titan-gatekeeper" },
    "errorReporter": { "name": "op-titan-errors" },

    // Public front door. Deployed only when at least one integration below is enabled.
    // It owns the Workshop route, dispatches /gatekeeper/<name>/* to each gatekeeper Worker,
    // and forwards everything else to the (now private) Workshop backend.
    // Reference: docs/integrations.md
    "router": { "name": "op-titan-router" }
  },

  // This starter deploys Cloudflare Access mode. Cloudflare OS also supports built-in password
  // accounts and auth Gatekeeper sign-in; see the reference below before switching. The audience
  // comes from the self-hosted Access application protecting the Workshop hostname.
  // "admins" gates /admin in every sign-in method.
  // Reference: docs/customization.md#sign-in-methods
  "access": {
    "issuer": "https://lively-lab-23fb.cloudflareaccess.com",
    "audience": "26a1c5441149b459cd9609fef6874611d774802fb5c7763291655ac00c602894",
    "admins": ["shimanta@originalpictures.com"]
  },

  // Optional platform-funded model catalog. Leave disabled to deploy without AI setup.
  // When enabled, replace every placeholder and install CF_AI_GATEWAY_API_TOKEN separately.
  // Reference: docs/customization.md#ai-models
  "aiGateway": {
    "enabled": true,
    "name": "op-titan-ai",
    "accountId": "1a4ab9bfc9016c26a79d18840d614a03",
    "providers": ["anthropic", "openai", "google", "openrouter"],

    // "direct" sends Workers AI to its REST endpoint. "gateway" adds AI Gateway logs.
    "workersAi": { "mode": "gateway", "gateway": "op-titan-ai" }
  },

  "context": {
    // Isolates Context data shared by this Workshop deployment.
    "sharingDomain": "production",

    // null: Wrangler provisions and remembers a KV namespace on first deploy.
    // string: bind an existing namespace by ID.
    "kvNamespaceId": null
  },

  // Displayed to agents when the example custom integration is enabled in /admin.
  // Reference: docs/customization.md#custom-gatekeepers
  "customGatekeeper": {
    "name": "Original Pictures",
    "message": "Titan is Original Pictures internal AI workspace."
  },

  // Built-in Cloudflare OS gatekeepers that connect agents and Gadgets to third-party services.
  // Each enabled entry deploys its upstream gatekeeper Worker, binds it into the router (for OAuth
  // at /gatekeeper/<name>/*) and into the Workshop backend (for agent discovery, entrypoint
  // GatekeeperVendor). Users connect each service from /admin after deploy.
  //
  // Prerequisite: enabling ANY integration requires a Workshop custom domain (set
  // workers.workshop.route.customDomain above), because OAuth redirect URIs need a stable host.
  // OAuth client credentials are per-service Wrangler secrets, never stored here.
  // Reference: docs/integrations.md
  "integrations": {
    "github": { "enabled": true, "name": "op-titan-github" },
    "google": { "enabled": true, "name": "op-titan-google" },
    "slack": { "enabled": true, "name": "op-titan-slack" },
    "linear": { "enabled": true, "name": "op-titan-linear" }
  },

  // Explicit backend issue reports go to a private Worker that emits structured console errors.
  // Set release to a commit/version when your deployment pipeline has one.
  // Reference: docs/observability.md#quick-start
  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // null values use Wrangler automatic provisioning. Set IDs/names to reuse owned resources.
  // https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
  "resources": {
    "blueprintsKvNamespaceId": null,
    "avatarsKvNamespaceId": null,
    "blueprintContentBucket": null
  },

  // Structured custom logs stay enabled. Invocation logs and traces are separate volume controls.
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
